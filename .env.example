# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real credentials.
#
# In production (AWS), these are NOT read from .env — they're injected as
# environment variables by ECS from AWS Secrets Manager. See docs/AWS_DEPLOYMENT.md.

ENTSOE_API_KEY=your-entsoe-api-key-here
OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# Optional — defaults shown
COUNTRY_CODE=ES
CITIES=Madrid,Barcelona,Valencia,Seville,Bilbao
FORECAST_HOURS=24
FETCH_INTERVAL_MIN=60
